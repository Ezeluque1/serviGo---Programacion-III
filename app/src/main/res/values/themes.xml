<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema de la app: usa la paleta serviGO definida en colors.xml -->
    <style name="Theme.ServiGOv2" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/servigo_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/servigo_teal</item>
        <item name="android:colorBackground">@color/servigo_background</item>
        <item name="colorSurface">@color/servigo_surface</item>
        <!--
          statusBarColor solo tiene efecto hasta Android 14. Desde Android 15 la
          barra es transparente si o si, y el color que se ve es el fondo del
          layout (por eso la raiz de cada pantalla es blanca).
        -->
        <item name="android:statusBarColor">@color/servigo_surface</item>
        <!-- Iconos oscuros (hora, bateria, señal) para que se lean sobre el blanco -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Estilo del titulo grande de cada pantalla -->
    <style name="TextoTituloGrande">
        <item name="android:textSize">@dimen/texto_titulo_grande</item>
        <item name="android:textColor">@color/servigo_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Estilo del nombre de un servicio dentro de la tarjeta -->
    <style name="TextoNombre">
        <item name="android:textSize">@dimen/texto_nombre</item>
        <item name="android:textColor">@color/servigo_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Estilo de los textos secundarios (direccion, cantidad de resenias) -->
    <style name="TextoSecundario">
        <item name="android:textSize">@dimen/texto_cuerpo</item>
        <item name="android:textColor">@color/servigo_text_secondary</item>
    </style>

    <!-- Estilo del boton azul principal -->
    <style name="BotonPrimario" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/servigo_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/radio_boton</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Chip de categoria: pastilla azul cuando esta seleccionado -->
    <style name="ChipCategoria" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_fondo</item>
        <item name="android:textColor">@color/chip_texto</item>
        <item name="chipStrokeColor">@color/chip_borde</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/radio_chip</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">@dimen/texto_cuerpo</item>
    </style>
</resources>
