    <string name="formato_resenias">(%1$s reseñas)</string>
    <string name="servicio_no_encontrado">No se pudo cargar el servicio.</string>

    <!-- Descripciones para accesibilidad -->
    <string name="desc_buscar">Buscar</string>
    <string name="desc_volver">Volver</string>
    <string name="desc_imagen_servicio">Imagen del servicio</string>
    <string name="desc_rating">Puntuación</string>
    <string name="desc_ubicacion">Ubicación</string>

    <!--
      Chips de categoria. Son dos listas en paralelo:
      "nombres" es lo que se ve, "consultas" es la palabra que se manda a la API.
      El primero ("Todos") manda texto vacio, o sea: muestra todo lo guardado.
    -->
    <string-array name="categorias_nombres">
        <item>@string/categoria_todos</item>
        <item>@string/categoria_plomeria</item>
        <item>@string/categoria_electricidad</item>
        <item>@string/categoria_gas</item>
        <item>@string/categoria_cerrajeria</item>
        <item>@string/categoria_limpieza</item>
    </string-array>

    <string-array name="categorias_consultas">
        <item></item>
        <item>plomero</item>
        <item>electricista</item>
        <item>gasista</item>
        <item>cerrajero</item>
        <item>limpieza</item>
    </string-array>
</resources>
