    <string name="marca_go">GO</string>

    <!-- Pantalla de servicios -->
    <string name="titulo_servicios">¿Qué necesitás resolver hoy?</string>
    <string name="hint_buscador">Buscá plomero, electricista, cerrajero…</string>
    <string name="subtitulo_lista">Profesionales cerca</string>
    <string name="sin_resultados">No se encontraron servicios</string>
    <string name="sin_resultados_detalle">Probá buscando otro oficio o revisá tu conexión.</string>
    <string name="aviso_limite_diario">Alcanzaste el límite diario de búsquedas. Te mostramos los servicios ya guardados.</string>
    <string name="aviso_sin_conexion">Sin conexión. Mostrando los servicios guardados.</string>
    <string name="ver_detalle">Ver detalle</string>

    <!-- Chips de categoria: son atajos de busqueda, no datos de servicios -->
    <string name="categoria_todos">Todos</string>
    <string name="categoria_plomeria">Plomería</string>
    <string name="categoria_electricidad">Electricidad</string>
    <string name="categoria_gas">Gasista</string>
    <string name="categoria_cerrajeria">Cerrajería</string>
    <string name="categoria_limpieza">Limpieza</string>

    <!-- Pantalla de detalle -->
    <string name="titulo_detalle">Detalle del servicio</string>
    <string name="etiqueta_precio">Precio</string>
    <string name="etiqueta_direccion">Dirección</string>
    <string name="etiqueta_descripcion">Sobre el servicio</string>
    <string name="sin_contacto">Este servicio no publicó datos de contacto.</string>
    <string name="boton_llamar">Llamar</string>
